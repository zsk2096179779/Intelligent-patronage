<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.backend.mapper.StrategyFilterRuleMapper">

    <resultMap id="strategyFilterRuleResultMap" type="com.example.backend.entity.StrategyFilterRule">
        <id column="id" property="id"/>
        <result column="strategy_id" property="strategyId"/>
        <result column="top_n" property="topN"/>
        <result column="type_limit" property="typeLimit"/>
        <result column="scale_limit" property="scaleLimit"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <insert id="insert" parameterType="com.example.backend.entity.StrategyFilterRule" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO strategy_filter_rule
        (strategy_id, top_n, type_limit, scale_limit, created_at, updated_at)
        VALUES
        (#{strategyId}, #{topN}, #{typeLimit}, #{scaleLimit}, #{createdAt}, #{updatedAt})
    </insert>

    <select id="findByStrategyId" parameterType="long" resultMap="strategyFilterRuleResultMap">
        SELECT id, strategy_id, top_n, type_limit, scale_limit, created_at, updated_at
        FROM strategy_filter_rule
        WHERE strategy_id = #{strategyId}
        ORDER BY created_at ASC
    </select>

    <update id="update" parameterType="com.example.backend.entity.StrategyFilterRule">
        UPDATE strategy_filter_rule
        SET top_n = #{topN},
            type_limit = #{typeLimit},
            scale_limit = #{scaleLimit},
            updated_at = NOW()
        WHERE id = #{id}
    </update>

    <delete id="deleteByStrategyId" parameterType="long">
        DELETE FROM strategy_filter_rule WHERE strategy_id = #{strategyId}
    </delete>

    <delete id="deleteById" parameterType="long">
        DELETE FROM strategy_filter_rule WHERE id = #{id}
    </delete>
</mapper>

