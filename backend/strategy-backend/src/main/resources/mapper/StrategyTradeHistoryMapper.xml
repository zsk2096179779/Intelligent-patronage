<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.backend.mapper.StrategyTradeHistoryMapper">

    <resultMap id="StrategyTradeHistoryMap" type="com.example.backend.entity.StrategyTradeHistory">
        <id column="id" property="id"/>
        <result column="strategy_id" property="strategyId"/>
        <result column="trade_time" property="tradeTime"/>
        <result column="stock_code" property="stockCode"/>
        <result column="stock_name" property="stockName"/>
        <result column="operation_type" property="operationType"/>
        <result column="price" property="price"/>
        <result column="quantity" property="quantity"/>
        <result column="amount" property="amount"/>
        <result column="fee" property="fee"/>
    </resultMap>

    <select id="findByStrategyId" parameterType="long" resultMap="StrategyTradeHistoryMap">
        SELECT id, strategy_id, trade_time, stock_code, stock_name, operation_type, price, quantity, amount, fee
        FROM strategy_trade_history
        WHERE strategy_id = #{strategyId}
        ORDER BY trade_time DESC
    </select>
</mapper>

