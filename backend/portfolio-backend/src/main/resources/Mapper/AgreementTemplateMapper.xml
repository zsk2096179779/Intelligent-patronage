<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.train_back.mapper.AgreementTemplateMapper">

    <resultMap id="AgreementTemplateMap"
               type="com.example.train_back.entity.AgreementTemplate">
        <id property="id" column="id"/>
        <result property="agreementCode" column="agreement_code"/>
        <result property="agreementType" column="agreement_type"/>
        <result property="title" column="title"/>
        <result property="content" column="content"/>
        <result property="contentHash" column="content_hash"/>
        <result property="applicableScenario" column="applicable_scenario"/>
        <result property="version" column="version"/>
        <result property="isLatest" column="is_latest"/>
        <result property="status" column="status"/>
        <result property="effectiveDate" column="effective_date"/>
        <result property="expireDate" column="expire_date"/>
        <result property="viewCount" column="view_count"/>
        <result property="signCount" column="sign_count"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <!-- query by id -->
    <select id="selectById"
            parameterType="int"
            resultMap="AgreementTemplateMap">
        SELECT
            id,
            agreement_code,
            agreement_type,
            title,
            content,
            content_hash,
            applicable_scenario,
            version,
            is_latest,
            status,
            effective_date,
            expire_date,
            view_count,
            sign_count,
            created_at,
            updated_at
        FROM agreement_template
        WHERE id = #{id}
    </select>

    <!-- list templates by scenario -->
    <select id="selectByScenario"
            parameterType="string"
            resultMap="AgreementTemplateMap">
        SELECT
        id,
        agreement_code,
        agreement_type,
        title,
        content,
        content_hash,
        applicable_scenario,
        version,
        is_latest,
        status,
        effective_date,
        expire_date,
        view_count,
        sign_count,
        created_at,
        updated_at
        FROM agreement_template
        WHERE FIND_IN_SET(#{scenario}, applicable_scenario)
        AND status = 1
        AND is_latest = 1
        AND effective_date &lt;= CURRENT_DATE()
        AND (expire_date IS NULL OR expire_date >= CURRENT_DATE())
        ORDER BY id ASC
    </select>

    <!-- view_count + 1 -->
    <update id="increaseViewCount" parameterType="int">
        UPDATE agreement_template
        SET view_count = IFNULL(view_count, 0) + 1
        WHERE id = #{id}
    </update>

    <!-- sign_count + 1 -->
    <update id="increaseSignCount" parameterType="int">
        UPDATE agreement_template
        SET sign_count = IFNULL(sign_count, 0) + 1
        WHERE id = #{id}
    </update>

</mapper>
