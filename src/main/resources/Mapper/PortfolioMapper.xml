<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.train_back.mapper.PortfolioMapper">

    <resultMap id="PortfolioMap" type="com.example.train_back.entity.Portfolio">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="risk_level" property="riskLevel"/>
        <result column="strategy_type" property="strategyType"/>
        <result column="strategy_id" property="strategyId"/>
        <result column="listed" property="listed"/>
    </resultMap>

    <select id="selectById" parameterType="int" resultMap="PortfolioMap">
        SELECT
            id,
            name,
            risk_level,
            strategy_type,
            strategy_id,
            listed
        FROM portfolios
        WHERE id = #{id}
    </select>

</mapper>
